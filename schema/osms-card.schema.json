{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensecuritymetrics.org/schema/0.9.2-draft/osms-card.schema.json",
  "title": "OSMS Metric Card Contract (production structure)",
  "description": "Open Security Metrics Standard (OSMS) v0.9 — calibrated 2026-07-04 against osms-catalog.yaml (flat card structure, 47 contract fields). Enums mirror catalog/taxonomy.yaml plus the calculation types declared in the catalog header. Licensed CC BY 4.0; schema file itself MIT.",
  "type": "object",
  "required": [
    "id",
    "name",
    "osms_version",
    "card_version",
    "release_status",
    "domain",
    "type_label",
    "type",
    "lag_type",
    "priority",
    "mvp",
    "status",
    "scope",
    "unit",
    "purpose",
    "story",
    "management_question",
    "definition",
    "formula",
    "calculation_type",
    "calculation_type_check",
    "calculation_plain",
    "variables_inputs",
    "rebuild_steps",
    "special_cases_gates",
    "calculation_example",
    "target_thresholds",
    "numerator_denominator",
    "frequency",
    "threshold_mode",
    "direction",
    "accountable_owner",
    "escalation_owner",
    "data_sources",
    "minimum_data_fields",
    "framework_mapping",
    "audit_test",
    "reproducibility",
    "drilldown_lineage",
    "data_confidence",
    "confidence_production_rule",
    "decision_chain",
    "version_break_rule",
    "interpretation",
    "example_tasks",
    "guardrails",
    "next_chain"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3}[a-z]?$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "osms_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "card_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "release_status": {
      "type": "string",
      "examples": [
        "review_candidate"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "domain": {
      "type": "string",
      "minLength": 2,
      "description": "Must match an entry in catalog/domains.yaml (checked semantically by the validator).",
      "pattern": "\\S"
    },
    "type_label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "enum": [
        "metric",
        "kpi",
        "kri",
        "kci",
        "outcome",
        "confidence",
        "maturity",
        "helper"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "lag_type": {
      "type": "string",
      "enum": [
        "leading",
        "lagging",
        "not_specified"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "mvp": {
      "type": "string",
      "pattern": "^MVP-[0-9]$",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "normative_candidate",
        "helper"
      ],
      "description": "Helper cards are not independently reportable.",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose": {
      "type": "string",
      "minLength": 20,
      "pattern": "\\S"
    },
    "story": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "management_question": {
      "type": "string",
      "minLength": 10,
      "pattern": "\\S"
    },
    "definition": {
      "type": "string",
      "minLength": 10,
      "pattern": "\\S"
    },
    "formula": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "calculation_type": {
      "type": "string",
      "enum": [
        "Ratio",
        "Duration",
        "Count",
        "Weighted Sum",
        "Weighted Average",
        "Composite",
        "Penalty",
        "Index",
        "Ranking",
        "Monetary Risk",
        "Delta",
        "Score",
        "Unit Cost"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "calculation_type_check": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "calculation_plain": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "variables_inputs": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rebuild_steps": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "special_cases_gates": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "calculation_example": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "target_thresholds": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "numerator_denominator": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "frequency": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "threshold_mode": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "direction": {
      "type": "string",
      "pattern": "^(higher_is_better|lower_is_better|zero_is_target|band_is_better|context_dependent)\\b",
      "description": "Machine-readable prefix followed by ' - ' and prose context.",
      "minLength": 1
    },
    "accountable_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "escalation_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "minimum_data_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "allOf": [
        {
          "contains": {
            "const": "evidence_ref"
          }
        },
        {
          "contains": {
            "const": "record_id"
          }
        },
        {
          "contains": {
            "const": "source_system"
          }
        }
      ],
      "description": "Evidence trio (evidence_ref, record_id, source_system) is mandatory for auditability."
    },
    "framework_mapping": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "audit_test": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reproducibility": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "drilldown_lineage": {
      "type": "string",
      "description": "Contains the 'Pfad:' segment with at most 4 steps (value -> dimension -> record -> raw/evidence).",
      "minLength": 1,
      "pattern": "\\S"
    },
    "data_confidence": {
      "type": "string",
      "description": "Must reference the 70 (operational) and 85 (management) gates.",
      "minLength": 1,
      "pattern": "\\S"
    },
    "confidence_production_rule": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decision_chain": {
      "type": "string",
      "minLength": 30,
      "pattern": "\\S"
    },
    "version_break_rule": {
      "type": "string",
      "minLength": 15,
      "pattern": "\\S"
    },
    "interpretation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "example_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "next_chain": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "description": "Provenance of the card (kind + source_card_version); internal file names are stripped for the public release."
    }
  }
}
